# Aruba Fabric Composer API endpoint, example: https://afc.example.local
AFC_BASE_URL=

# API credentials
AFC_USERNAME=
AFC_PASSWORD=

# true|false
AFC_VERIFY_SSL=false
AFC_TIMEOUT=30

# MCP listener (address/port the server listens on INSIDE the container;
# docker-compose maps container 8000 -> host 8010). Not related to auth.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# MCP client authentication (Bearer token).
# When true, clients must send `Authorization: Bearer <token>`; generate tokens
# with `python afc_token_manager.py generate --name <client>`.
AFC_AUTH_ENABLED=false
# Trust the X-Forwarded-For header (only behind a trusted reverse proxy).
AFC_TRUST_FORWARDED_FOR=false
